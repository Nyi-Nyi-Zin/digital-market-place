DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cloud_nine
BETTER_AUTH_URL=http://localhost:3000
# Separate customer and admin origins; set real HTTPS URLs before production builds.
NEXT_PUBLIC_CUSTOMER_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
# Generate locally with: openssl rand -base64 48
BETTER_AUTH_SECRET=
# Required for production email verification and password recovery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Optional Resend setup helper: verify your sending domain, save its API key locally,
# then run pnpm notifications:setup --resend --from "Cloud Nine <notifications@notify.your-domain.com>"
# The helper configures the SMTP settings above. Never commit a real API key.
RESEND_API_KEY=
# Transactional order notifications reuse the SMTP settings above.
# Run `pnpm notifications:setup --subject https://your-domain.com` to save missing keys.
# Keep the private key server-only and preserve existing keys for subscribed devices.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# At least 32 random characters. Used ONLY by your scheduler, never in browser code.
NOTIFICATION_WORKER_SECRET=
# Cloudinary storage. Set the same server-only credentials on both sites.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Default matches the Free plan raw-file limit; raise only within your plan (max 25).
CLOUDINARY_MAX_FILE_MB=10
# Only for the optional read-only legacy MySQL import.
LEGACY_MYSQL_URL=

# One store currency; changing this does not convert existing amounts.
NEXT_PUBLIC_MARKETPLACE_CURRENCY=USD
