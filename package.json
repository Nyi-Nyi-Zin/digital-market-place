{
  "name": "myanmar-digital-marketplace",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.4.1+sha512.c753b6c3ad7afa13af388fa6d808035a008e30ea9993f58c6663e2bc5ff21679aa834db094987129aa4d488b86df57f7b634981b2f827cdcacc698cc0cfb88af",
  "scripts": {
    "dev": "node scripts/dev-sites.mjs",
    "dev:customer": "node scripts/site.mjs customer dev",
    "dev:admin": "node scripts/site.mjs admin dev",
    "build": "node scripts/site.mjs customer build && node scripts/site.mjs admin build",
    "build:customer": "node scripts/site.mjs customer build",
    "build:admin": "node scripts/site.mjs admin build",
    "start": "node scripts/site.mjs customer start",
    "start:customer": "node scripts/site.mjs customer start",
    "start:admin": "node scripts/site.mjs admin start",
    "check": "node scripts/site.mjs customer typegen && node scripts/site.mjs admin typegen && tsc --noEmit && tsc --noEmit -p customer-web && tsc --noEmit -p admin && node scripts/check-boundaries.mjs && node scripts/check-tailwind.mjs",
    "check:styles": "node scripts/check-tailwind.mjs",
    "format": "prettier --write .",
    "test": "vitest run",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "admin:grant": "tsx scripts/admin-grant.ts",
    "notifications:worker": "tsx scripts/notification-worker.ts",
    "notifications:keys": "node scripts/notification-keys.mjs",
    "notifications:setup": "node scripts/notification-setup.mjs",
    "notifications:doctor": "node scripts/notification-doctor.mjs",
    "db:import-mysql": "tsx scripts/import-mysql.ts",
    "auth:link-legacy": "tsx scripts/link-legacy-user.ts",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "package:customer": "node scripts/package-site.mjs customer",
    "package:admin": "node scripts/package-site.mjs admin",
    "test:integration": "node scripts/test-integration.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "@types/pg": "^8.15.5",
    "@types/nodemailer": "^7.0.4",
    "drizzle-kit": "^0.31.4",
    "dotenv": "^17.2.2",
    "mysql2": "^3.15.0",
    "pg": "^8.16.3",
    "prettier": "^3.6.2",
    "tsx": "^4.19.1",
    "typescript": "5.9.3",
    "vitest": "^2.1.4",
    "next": "15.5.23",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "drizzle-orm": "0.45.2",
    "zod": "^4.1.12",
    "@marketplace/server": "workspace:*",
    "@marketplace/shared": "workspace:*",
    "cloudinary": "^2.11.0"
  }
}
