{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ],
    "incremental": true,
    "tsBuildInfoFile": "./.next/cache/tsbuildinfo",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./app/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next-dev/types/**/*.ts",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    "node_modules/.cache/product-detail-layout-qa/types/**/*.ts",
    "node_modules/.cache/product-detail-layout-qa-3136/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next/standalone"
  ]
}
